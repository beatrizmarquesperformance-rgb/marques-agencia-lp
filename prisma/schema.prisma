// Fixed content schema. The admin edits VALUES only — never structure.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  order       Int     @default(0)
  enabled     Boolean @default(true)
  comingSoon  Boolean @default(false)
  tagline     String? // short all-caps line under the logo
  description String  @default("") // paragraph copy, \n\n between paragraphs

  // hero
  heroImage      String? // URL (Blob). null => themed placeholder
  heroAlt        String  @default("")
  logoImage      String? // project lockup PNG/SVG URL
  heroCutout     String? // cut-out PNG that breaks across the torn edge
  heroCutoutSide String  @default("left") // left | right

  // vertical "category" video shown in the rail under the page hero
  promoProvider String  @default("mp4") // mp4 | mux | youtube | vimeo | cloudflare
  promoSrc      String?
  promoPoster   String?

  // theme tokens
  bg        String @default("#0d0d0d")
  primary   String @default("#ffffff")
  secondary String @default("#888888")
  text      String @default("#ffffff")
  accent    String @default("#ffffff")

  socials Social[]
  photos  GalleryPhoto[]
  videos  Video[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Social {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform  String // instagram | tiktok | facebook | youtube | website
  url       String
  order     Int     @default(0)
}

model GalleryPhoto {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  image     String // URL
  alt       String  @default("")
  order     Int     @default(0)
}

model Video {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider  String  @default("mp4") // mp4 | mux | youtube | vimeo | cloudflare
  src       String // URL or playback id
  poster    String? // poster image URL
  title     String  @default("")
  order     Int     @default(0)
}

model PlayedAt {
  id      String  @id @default(cuid())
  name    String
  logo    String? // URL
  url     String?
  order   Int     @default(0)
  enabled Boolean @default(true)
}

model Setting {
  key   String @id
  value String
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  BOOKED
  WON
  LOST
}

model Lead {
  id      String @id @default(cuid())
  name    String
  email   String
  phone   String
  company String @default("")
  dates   String @default("[]") // JSON array of "yyyy-mm-dd"
  project String @default("")
  message String @default("")
  source  String @default("modal") // modal | page

  status LeadStatus @default(NEW)

  // referral attribution — filled server-side from the mq_ref cookie, never the client
  referralId String?
  referral   Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)

  // tracking (optional, for future analytics)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  landingPath String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([referralId, createdAt])
  @@index([status])
}

/// A partner who refers potential clients through a unique link (/r/{code}).
model Referral {
  id        String   @id @default(cuid())
  name      String
  company   String   @default("")
  email     String   @default("")
  code      String   @unique // e.g. "joao-x7k2" — stored lowercase, generated automatically
  active    Boolean  @default(true)
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads  Lead[]
  visits ReferralVisit[]
}

/// One visit that arrived through a referral link. Keeps every touch so a
/// multi-touch model can be computed later without data loss.
model ReferralVisit {
  id          String   @id @default(cuid())
  referralId  String
  referral    Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  path        String   @default("/")
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referer     String?
  createdAt   DateTime @default(now())

  @@index([referralId, createdAt])
}
