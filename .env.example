# ---- Database (Vercel Postgres / any Postgres) ----
# Leave BLANK to run the site from the built-in seed content (no DB needed).
DATABASE_URL=

# ---- Admin auth ----
# bcrypt-style not needed; we compare a SHA-256 hash. Generate with:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
ADMIN_PASSWORD_HASH=
# Any long random string. Generate with: openssl rand -hex 32
AUTH_SECRET=

# ---- Bandsintown ----
# Register an app id at https://www.artists.bandsintown.com/support/api-installation
BANDSINTOWN_APP_ID=
# The exact Bandsintown artist name or "id_<number>"
BANDSINTOWN_ARTIST=

# ---- Media storage (added when wiring uploads) ----
BLOB_READ_WRITE_TOKEN=
