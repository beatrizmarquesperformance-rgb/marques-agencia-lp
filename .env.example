# ---- Database (any Postgres: Neon / Supabase / self-hosted) ----
# Leave BLANK to run the PUBLIC SITE from the built-in seed content (no DB needed).
# REQUIRED for the backoffice CRM (Referrals + Leads) — those are dynamic data,
# not seed content. Without it, /admin shows "precisa de base de dados".
DATABASE_URL=

# ---- Admin auth ----
# bcrypt-style not needed; we compare a SHA-256 hash. Generate with:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
ADMIN_PASSWORD_HASH=
# Any long random string. Generate with: openssl rand -hex 32
AUTH_SECRET=

# ---- Media storage ----
# Admin uploads are written to ./media-store on disk (served via
# /api/media/...) — no external service or token needed, works out of the box
# on any server with a persistent filesystem.

# ---- Public site URL ----
# Used to build the referral links shown in the backoffice, e.g. https://dominio.com
# (the link becomes https://dominio.com/r/<codigo>). No trailing slash.
NEXT_PUBLIC_SITE_URL=

# ---- Telegram lead notifications (optional) ----
# Bot token from @BotFather. Chat id: add the bot to the group, POST a message,
# then GET https://api.telegram.org/bot<TOKEN>/getUpdates and read result[].chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
